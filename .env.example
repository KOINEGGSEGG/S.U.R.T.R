# Supabase (pre-populated by Bolt — do not change)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini API key — set this in the Bolt Secrets tab, NOT here.
# The edge function reads it server-side as GEMINI_API_KEY.
# Bolt Secrets: click the database icon → Secrets → add GEMINI_API_KEY
